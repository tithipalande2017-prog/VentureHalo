rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    
    // Global rule: require authentication for all access
    allow read, write: if request.auth != null;
    
    // Meetings collection: only allow access if user is founder or investor
    match /meetings/{meetingId} {
      allow read: if request.auth.uid == resource.data.founderId 
                  || request.auth.uid == resource.data.investorId;
      
      allow create: if request.auth.uid == request.resource.data.founderId 
                   || request.auth.uid == request.resource.data.investorId;
      
      allow update: if request.auth.uid == resource.data.founderId 
                   || request.auth.uid == resource.data.investorId;
      
      allow delete: if request.auth.uid == resource.data.founderId 
                   || request.auth.uid == resource.data.investorId;
    }
    
    // Notifications collection: only allow access if user is recipient
    match /notifications/{notificationId} {
      allow read: if request.auth.uid == resource.data.recipientId;
      allow create: if request.auth.uid == request.resource.data.recipientId;
      allow update: if request.auth.uid == resource.data.recipientId;
      allow delete: if request.auth.uid == resource.data.recipientId;
    }
    
    // Users collection: users can only access their own profile
    match /users/{userId} {
      allow read: if request.auth.uid == userId;
      allow write: if request.auth.uid == userId;
    }
  }
}
